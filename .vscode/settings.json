{
  "cucumber.features": [
    "features/**/*.feature"
  ],
  "cucumber.glue": [
    "steps/**/*.ts",
    "support/**/*.ts"
  ],
  "files.eol": "\n",
  "editor.tabSize": 2,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  }
}